# =============================================================================
# Dockerfile.h3sim -- Accel-Sim build environment for the H3 hybrid memory study
#
# Derived from what the cloned repo actually requires:
#   * .devcontainer/devcontainer.json      -> ghcr.io/accel-sim/accel-sim-framework:Ubuntu-24.04-cuda-12.8
#   * README.md "Dependencies"             -> Ubuntu 24.04 + CUDA 12.8, apt list below
#   * accel-sim/Dockerfile (upstream)      -> base nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04
#   * .github/scripts/main-sass.sh         -> sources env-setup/12.8_env_setup.sh (CUDA 12.8)
#   * gpu-simulator/CMakeLists.txt         -> cmake >= 3.17, C++17, pybind11 (needs Python headers)
#   * gpu-simulator/version_detection.mk   -> invokes $CUDA_INSTALL_PATH/bin/nvcc  => needs -devel
#
# This image ONLY prepares the environment. It intentionally does not build.
# Build for x86-64 on Apple Silicon:  docker build --platform linux/amd64 ...
# =============================================================================
FROM --platform=linux/amd64 nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# -----------------------------------------------------------------------------
# System dependencies
#   Group 1: exact list from accel-sim-framework/README.md "Dependencies".
#   Group 2: additions this repo needs that the upstream list omits --
#     libzstd-dev  : README states it is required for the compressed .tracez format,
#                    and gpu-simulator/Makefile links -lzstd.
#     python3-dev  : CMakeLists.txt calls pybind11_add_module() unconditionally,
#                    which requires Python.h. Not pulled in by python3-pip.
#     xutils-dev   : provides `makedepend`, used by the legacy Makefile path.
#     cmake/ninja  : CI builds via `cmake -S ./gpu-simulator/ -B ...` (>= 3.17).
#     libglu1-mesa-dev/freeglut3-dev : accel-sim.out links -lGL.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      wget curl git vim gdb ca-certificates pkg-config bash-completion \
      build-essential g++ bison flex xutils-dev \
      zlib1g-dev libzstd-dev zstd libssl-dev libxml2-dev libboost-all-dev \
      libglu1-mesa-dev freeglut3-dev libfreeimage-dev \
      cmake ninja-build \
      python3 python3-dev python3-pip python3-setuptools python3-venv \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Python environment.
# Ubuntu 24.04 enforces PEP 668, so a venv is required (same approach upstream uses).
# -----------------------------------------------------------------------------
ENV VIRTUAL_ENV=/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH=$VIRTUAL_ENV/bin:$PATH

# requirements.txt from the repo: pyyaml pandas plotly kaleido psutil tqdm
COPY requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip \
 && pip install -r /tmp/requirements.txt \
 && pip install mypy

# CMakeLists.txt' gen_pyi target invokes $HOME/.local/bin/stubgen literally.
# It is wrapped in "|| (exit 0)", but wire it up so the .pyi stubs actually get made.
RUN mkdir -p /root/.local/bin && ln -sf $VIRTUAL_ENV/bin/stubgen /root/.local/bin/stubgen

# -----------------------------------------------------------------------------
# Environment variables consumed by setup_environment.sh / CMakeLists.txt / Makefile
# -----------------------------------------------------------------------------
ENV CUDA_INSTALL_PATH=/usr/local/cuda \
    PTXAS_CUDA_INSTALL_PATH=/usr/local/cuda \
    BOOST_ROOT=/usr/include/boost \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# gpu-simulator/setup_environment.sh clones GPGPU-Sim from these if $GPGPUSIM_ROOT is unset.
# GPGPU-Sim is NOT a git submodule of this repo -- it is pulled at setup time.
ENV GPGPUSIM_REPO=https://github.com/accel-sim/gpgpu-sim_distribution.git \
    GPGPUSIM_BRANCH=dev

ENV ACCELSIM_ROOT=/workspace/h3-sim/gpu-simulator \
    GPUAPPS_ROOT=/workspace/h3-sim/gpu-app-collection

# CMakeLists.txt runs `git log` / `git diff` in the source tree; the bind-mounted
# repo is owned by the host user, so mark it safe to avoid dubious-ownership errors.
RUN git config --global --add safe.directory '*'

# -----------------------------------------------------------------------------
# Repository. docker-compose bind-mounts the host copy over this path at runtime;
# the COPY keeps the image self-contained when run without compose.
# -----------------------------------------------------------------------------
WORKDIR /workspace/h3-sim
COPY . /workspace/h3-sim

# No build here -- environment only, as required.
CMD ["/bin/bash"]
