+
+// ---------------------------------------------------------------------------
+// H3 hybrid memory backend cycle.
+//
+// Structurally identical to dram_cycle() above -- the same return-queue drain,
+// the same sub-partition arbitration, the same DRAM latency queue -- with
+// m_dram replaced by m_h3_backend. Keeping the shape identical is deliberate:
+// any divergence would make H3 and baseline results incomparable for reasons
+// unrelated to the memory technology.
+// ---------------------------------------------------------------------------
+void memory_partition_unit::h3_dram_cycle() {
+  // 1. Drain completed requests back to the owning sub partition.
+  mem_fetch *mf_return = (mem_fetch *)m_h3_backend->return_queue_top();
+  if (mf_return) {
+    unsigned dest_global_spid = mf_return->get_sub_partition_id();
+    int dest_spid = global_sub_partition_id_to_local_id(dest_global_spid);
+    assert(m_sub_partition[dest_spid]->get_id() == dest_global_spid);
+    if (!m_sub_partition[dest_spid]->dram_L2_queue_full()) {
+      if (mf_return->get_access_type() == L1_WRBK_ACC) {
+        m_sub_partition[dest_spid]->set_done(mf_return);
+        delete mf_return;
+      } else {
+        m_sub_partition[dest_spid]->dram_L2_queue_push(mf_return);
+        mf_return->set_status(IN_PARTITION_DRAM_TO_L2_QUEUE,
+                              m_gpu->gpu_sim_cycle + m_gpu->gpu_tot_sim_cycle);
+        m_arbitration_metadata.return_credit(dest_spid);
+      }
+      m_h3_backend->return_queue_pop();
+    }
+  }
+
+  // 2. Advance the H3 stack by one DRAM clock.
+  m_h3_backend->cycle();
+
+  // 3. L2 -> DRAM latency queue, arbitrated across sub partitions.
+  int last_issued_partition = m_arbitration_metadata.last_borrower();
+  for (unsigned p = 0; p < m_config->m_n_sub_partition_per_memory_channel;
+       p++) {
+    int spid = (p + last_issued_partition + 1) %
+               m_config->m_n_sub_partition_per_memory_channel;
+    if (!m_sub_partition[spid]->L2_dram_queue_empty() &&
+        can_issue_to_dram(spid)) {
+      mem_fetch *mf = m_sub_partition[spid]->L2_dram_queue_top();
+      if (m_h3_backend->full(mf->is_write())) break;
+
+      m_sub_partition[spid]->L2_dram_queue_pop();
+      dram_delay_t d;
+      d.req = mf;
+      d.ready_cycle = m_gpu->gpu_sim_cycle + m_gpu->gpu_tot_sim_cycle +
+                      m_config->dram_latency;
+      m_dram_latency_queue.push_back(d);
+      mf->set_status(IN_PARTITION_DRAM_LATENCY_QUEUE,
+                     m_gpu->gpu_sim_cycle + m_gpu->gpu_tot_sim_cycle);
+      m_arbitration_metadata.borrow_credit(spid);
+      break;  // the DRAM accepts only one request per cycle
+    }
+  }
+
+  // 4. Latency queue -> H3 backend.
+  //    NOTE: full() here is a RETRY, not a drop. If the backend is full the
+  //    request stays at the head of the latency queue and is offered again on
+  //    the next cycle, exactly as dram_cycle() does with m_dram.
+  if (!m_dram_latency_queue.empty() &&
+      ((m_gpu->gpu_sim_cycle + m_gpu->gpu_tot_sim_cycle) >=
+       m_dram_latency_queue.front().ready_cycle) &&
+      !m_h3_backend->full(m_dram_latency_queue.front().req->is_write())) {
+    mem_fetch *mf = m_dram_latency_queue.front().req;
+    m_dram_latency_queue.pop_front();
+
+    h3::H3MemRequest req;
+    req.addr = mf->get_addr();
+    req.is_write = mf->is_write();
+    req.size_bytes = mf->get_data_size();
+    req.opaque = (void *)mf;
+    req.source_id = (int)mf->get_sub_partition_id();
+    m_h3_backend->push(req);
   }
 }
 
