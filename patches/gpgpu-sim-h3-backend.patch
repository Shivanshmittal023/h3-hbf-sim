+# -----------------------------------------------------------------------------
+# H3 hybrid memory backend (HBM3e + HBF + Latency Hiding Buffer)
+#
+# h3-components lives in the H3 project repository, NOT in GPGPU-Sim. It has no
+# GPGPU-Sim or Ramulator dependencies, so it can also be built and unit-tested
+# on its own (see scripts/run_unit_tests.sh).
+#
+# Layout:  <h3-sim>/gpu-simulator/gpgpu-sim/src/gpgpu-sim  <- we are here
+#          <h3-sim>/h3-components                          <- four levels up
+# -----------------------------------------------------------------------------
+set(H3_COMPONENTS_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../../../h3-components"
+    CACHE PATH "Path to the H3 memory system components")
+
+if(EXISTS "${H3_COMPONENTS_DIR}/CMakeLists.txt")
+    if(NOT TARGET h3components)
+        add_subdirectory(${H3_COMPONENTS_DIR} h3-components)
+    endif()
+    message(STATUS "GPGPU-Sim: H3 memory backend ENABLED (${H3_COMPONENTS_DIR})")
+else()
+    message(FATAL_ERROR
+        "H3 components not found at ${H3_COMPONENTS_DIR}. This GPGPU-Sim tree "
+        "has the H3 backend patch applied but the component sources are "
+        "missing. Either pass -DH3_COMPONENTS_DIR=<path>, or revert the patch "
+        "with ./scripts/apply_gpgpu_sim_patch.sh --revert")
+endif()
